# Byte-compiled files
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
env/
venv/

# VSCode
.vscode/

# PyTorch cache (if applicable)
*.pt
*.pth

# Logs, checkpoints, etc.
log/
checkpoints/
backup/
*.log
*.tar
*.tar.gz
*.ckpt

# Poetry artifacts
.cache/

# OS metadata
.DS_Store
Thumbs.db

# This is for `tree --gitignore` output
*/__pycache__/

# Tests
tests/

# Experiments and temporary artifacts
experiments/
/tmp/pygym_*/

# Configurations
# Ignore working drafts but keep templates and stable recipes
configs/draft/

# Ensure templates and stable configs are tracked
!configs/templates/
!configs/stable/
!configs/templates/*.json
!configs/stable/*.json
