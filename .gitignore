# Byte-compiled files
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
env/
venv/

# VSCode
.vscode/

# PyTorch cache (if applicable)
*.pt
*.pth

# Logs, checkpoints, etc.
log/
checkpoints/
backup/
*.log
*.tar
*.tar.gz
*.ckpt

# Test and coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Poetry artifacts
.cache/

# OS metadata
.DS_Store
Thumbs.db

# This is for `tree --gitignore` output
*/__pycache__/

# Experiments and temporary artifacts
# Records are tracked: text artifacts (summary.csv, REPORT.md, config.toml,
# training_log.csv) and comparison.png are small and are the point of a run.
# Heavy per-run artifacts (checkpoints, plots, logs) live in artifacts/, a cache
# that mirrors the experiments/ layout, and are ignored entirely.
artifacts/
/tmp/pygym_*/

# Configurations
# Ignore working drafts but keep templates and stable recipes
config/draft/

# Ensure templates and stable configs are tracked
!config/templates/
!config/stable/
