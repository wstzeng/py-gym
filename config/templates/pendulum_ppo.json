{
    "env": {
        "id": "Pendulum-v1",
        "state_dim": 3,
        "default": {},
        "training": {},
        "testing": {
            "render_mode": "human"
        }
    },
    "agent": {
        "type": "PPOAgent",
        "components": {
            "encoder": {
                "type": "VectorEncoder",
                "layers": [
                    {
                        "type": "Linear",
                        "out_features": 64
                    },
                    {
                        "type": "LeakyReLU"
                    }
                ]
            },
            "policy": {
                "type": "ActorCriticPolicy",
                "feature_dim": 64,
                "components": {
                    "actor": {
                        "type": "Sequential",
                        "layers": [
                            { "type": "Linear", "out_features": 3 }
                        ]
                    },
                    "critic": {
                        "type": "Sequential",
                        "layers": [
                            { "type": "Linear", "out_features": 64 },
                            { "type": "LeakyReLU" },
                            { "type": "Linear", "out_features": 1 }
                        ]
                    },
                    "handler": {
                        "type": "NormalHandler",
                        "params": {
                            "action_dim": 1,
                            "action_low": -2.0,
                            "action_high": 2.0
                        }
                    }
                }
            },
            "buffer": {
                "type": "TrajectoryBuffer"
            }
        }
    },
    "hyper_params": {
        "optimizer": {
            "type": "AdamW",
            "params": {
                "lrs": {
                    "default": 1e-3,
                    "critic": 1e-4
                },
                "weight_decay": 1e-2
            }
        },
        "eps_clip": 0.2,
        "k_epochs": 10,
        "critic_weight": 1e-2,
        "entropy_weight": 1e-2,
        "gamma": 0.99,
        "criterion": {
            "critic_loss": "SmoothL1Loss"
        }
    }
}
