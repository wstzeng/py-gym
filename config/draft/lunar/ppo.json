{
    "env": {
        "id": "LunarLander-v3",
        "state_dim": 8,
        "default": {
            "continuous": false,
            "enable_wind": false
        },
        "training": {},
        "testing": {
            "render_mode": "human"
        }
    },
    "agent": {
        "type": "PPOAgent",
        "components": {
            "encoder": {
                "type": "VectorEncoder",
                "layers": [
                    {
                        "type": "Linear",
                        "out_features": 128
                    },
                    {
                        "type": "LeakyReLU"
                    },
                    {
                        "type": "Linear",
                        "out_features": 128
                    },
                    {
                        "type": "LeakyReLU"
                    }
                ]
            },
            "policy": {
                "type": "ActorCriticPolicy",
                "feature_dim": 128,
                "components": {
                    "actor": [
                        {
                            "type": "Linear",
                            "out_features": 4
                        }
                    ],
                    "critic": [
                        {
                            "type": "Linear",
                            "out_features": 64
                        },
                        {
                            "type": "LeakyReLU"
                        },
                        {
                            "type": "Linear",
                            "out_features": 32
                        },
                        {
                            "type": "LeakyReLU"
                        },
                        {
                            "type": "Linear",
                            "out_features": 1
                        }
                    ],
                    "distributor": {
                        "type": "CategoricalDist",
                        "params": {}
                    }
                }
            },
            "buffer": {
                "type": "TrajectoryBuffer"
            }
        }
    },
    "hyper_params": {
        "optimizer": {
            "type": "AdamW",
            "lrs": {
                "default": 1e-3,
                "critic": 1e-4
            },
            "weight_decay": 1e-2
        },
        "eps_clip": 0.2,
        "k_epochs": 10,
        "critic_weight": 0.5,
        "entropy_weight": 0.01,
        "gamma": 0.99,
        "criterion": {
            "critic_loss": "SmoothL1Loss"
        }
    }
}
