{
    "env": {
        "id": "CartPole-v1",
        "state_dim": 4,
        "default": {},
        "training": {},
        "testing": {
            "render_mode": "human"
        }
    },
    "agent": {
        "type": "ReinforceAgent",
        "components": {
            "encoder": {
                "type": "VectorEncoder",
                "layers": [
                    {
                        "type": "Linear",
                        "out_features": 32
                    },
                    {
                        "type": "LeakyReLU"
                    }
                ]
            },
            "policy": {
                "type": "ActorPolicy",
                "feature_dim": 32,
                "components": {
                    "actor": [
                        {
                            "type": "Linear",
                            "out_features": 2
                        }
                    ],
                    "distributor": {
                        "type": "CategoricalDist",
                        "params": {}
                    }
                }
            },
            "buffer": {
                "type": "TrajectoryBuffer"
            }
        }
    },
    "hyper_params": {
        "optimizer": {
            "type": "Adam",
            "lrs": {
                "default": 1e-3
            }
        },
        "gamma": 0.99
    }
}
