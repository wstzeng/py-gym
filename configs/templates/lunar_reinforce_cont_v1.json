{
    "env": {
        "id": "LunarLander-v3",
        "state_dim": 8,
        "default": {
            "continuous": true
        },
        "training": {},
        "testing": {
            "render_mode": "human"
        }
    },
    "agent": {
        "type": "ReinforceAgent",
        "components": {
            "encoder": {
                "type": "VectorEncoder",
                "layers": [
                    {
                        "type": "Linear",
                        "out_features": 128
                    },
                    {
                        "type": "LeakyReLU"
                    }
                ]
            },
            "policy": {
                "type": "ActorPolicy",
                "feature_dim": 128,
                "components": {
                    "actor": [
                        {
                            "type": "Linear",
                            "out_features": 4
                        }
                    ],
                    "distributor": {
                        "type": "BetaDist",
                        "params": {
                            "action_low": -1.0,
                            "action_high": 1.0
                        }
                    }
                }
            },
            "buffer": {
                "type": "TrajectoryBuffer"
            }
        }
    },
    "hyper_params": {
        "optimizer": {
            "type": "Adam",
            "lrs": {
                "default": 1e-3
            }
        },
        "gamma": 0.99
    }
}
